NEXT_PUBLIC_API_URL=/backend-api

# Client/server error monitoring. Leave DSNs empty to keep reporting disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map uploads during CI builds (server-only values).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SOCKET_URL=http://localhost:10000
# Server-only backend URL used by Next.js route handlers and proxy validation.
API_URL=http://localhost:10000
