NEXT_PUBLIC_API_URL=/backend-api

# Client/server error monitoring. Leave DSNs empty to keep reporting disabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Source-map uploads during CI builds (server-only values).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SOCKET_URL=http://localhost:10000
# Server-only backend URL used by Next.js route handlers and proxy validation.
API_URL=http://localhost:10000

# Firebase AI Logic. These public values must be present at frontend build time.
# Use the same Firebase project as the backend Firebase Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Development only: use a debug token registered in Firebase App Check.
# Never set this variable in a production build.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
