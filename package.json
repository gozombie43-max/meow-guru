{
  "name": "meow-guru-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "9.0.4"
    }
  },
  "description": "Meow Guru — Smart Quiz Platform (Monorepo)",
  "workspaces": [
    "frontend",
    "backend",
    "contracts",
    "tools/azure-migration",
    "tools/next-lint-glob"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev": "concurrently --kill-others -n backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace @meow/contracts && npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test:run --workspace frontend && npm run test --workspace backend",
    "test:frontend": "npm run test:run --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "typecheck": "npm run typecheck --workspace @meow/contracts && npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "check": "npm run typecheck && npm run lint && npm run test",
    "start": "npm run start --workspace backend",
    "build:contracts": "npm run build --workspace @meow/contracts",
    "test:coverage": "npm run test:coverage --workspace frontend && npm run test:coverage --workspace backend"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "fast-glob": "$fast-glob",
    "katex": "0.19.0",
    "next": "16.4.2",
    "concurrently": {
      "shell-quote": "1.11.0"
    },
    "engine.io": "6.6.11",
    "follow-redirects": "1.16.1",
    "vite": "8.2.4",
    "dompurify": "3.4.17",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/mocker": "5.0.5",
    "@vitest/spy": "5.0.5",
    "@grpc/grpc-js": "^1.14.5",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "fast-uri": "^4.2.1",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "teeny-request": {
      "uuid": "^11.1.1"
    }
  },
  "keywords": [
    "ssc",
    "cgl",
    "quiz",
    "adaptive-learning",
    "katex",
    "nextjs"
  ],
  "author": "Meow Guru Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "fast-glob": "file:tools/next-lint-glob",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.5",
    "@img/sharp-darwin-x64": "0.35.5",
    "@img/sharp-libvips-darwin-arm64": "1.3.4",
    "@img/sharp-libvips-darwin-x64": "1.3.4",
    "@img/sharp-libvips-linux-arm64": "1.3.4",
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-arm64": "0.35.5",
    "@img/sharp-linux-x64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5",
    "@next/swc-darwin-arm64": "16.4.2",
    "@next/swc-darwin-x64": "16.4.2",
    "@next/swc-linux-arm64-gnu": "16.4.2",
    "@next/swc-linux-x64-gnu": "16.4.2",
    "@next/swc-win32-x64-msvc": "16.4.2",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3"
  }
}
