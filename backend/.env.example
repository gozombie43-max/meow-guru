PROCESS_ROLE=api
NODE_ENV=development
PORT=10000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=meow
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
# Replace both placeholders with DIFFERENT random secrets of at least 32 characters.
# Defaults enforce 100 Tutor requests, 40 MB and 10M conservative token credits per UTC day.
TUTOR_DAILY_REQUESTS=100
TUTOR_DAILY_ATTACHMENT_BYTES=41943040
TUTOR_DAILY_TOKEN_ALLOWANCE=10000000
TUTOR_QUEUED_JOBS=4
TUTOR_RUNNING_JOBS=2
# Full runtime enables online battles and their recovery/timeout workers.
# Use quiz-only mode only when intentionally disabling realtime features.
QUIZ_ONLY_MODE=false
RUN_EMBEDDED_WORKERS=true
# Concept grouping runs locally in development, including quiz-only mode.
# Set false when a separate maintenance worker owns it; production defaults off.
# RUN_CONCEPT_GROUPING_WORKER=true
# Production B1 uses QUIZ_ONLY_MODE=false, RUN_EMBEDDED_WORKERS=true and Always On.
# Embedded maintenance owns concept grouping; the standalone flag is a fallback.
# Alternatively run npm run start:worker with PROCESS_ROLE=worker for concept groups.
# Run npm run start:attachments with PROCESS_ROLE=attachments for tutor uploads.
# Optional shared Redis/Valkey; use the provider's TLS rediss:// URL in deployment.
# REDIS_URL=rediss://user:password@host:6379
# Required with Redis on deployed APIs/workers; all instances must share it.
# REDIS_NAMESPACE=meow:prod
# Staging uses DEPLOYMENT_ENVIRONMENT=staging and REDIS_NAMESPACE=meow:staging.
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_COMMANDS_QUEUE_MAX=4096
# Enable Redis Streams Socket.IO adapter when scaling horizontally (>1 API instance).
BATTLE_REDIS_ADAPTER=false
# Optional integrations fail separately from Mongo-backed quiz readiness.
BATTLE_REDIS_CRITICAL=false
EMBEDDED_WORKERS_CRITICAL=false
# Normalized question keys default to true for pure IXSCAN queries (run db:normalize -- --verify first).
QUESTIONS_NORMALIZED_KEYS=true
# Keep false in production; only set true temporarily during unbackfilled legacy migrations.
QUESTIONS_ALLOW_UNNORMALIZED_FALLBACK=false
# Offload cost-12 bcrypt hashing/verification to bounded worker_threads pool (set false only in tests).
AUTH_BCRYPT_WORKERS=true
# HTTP server & route timeout controls (ms).
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_ROUTE_TIMEOUT_MS=30000
HTTP_AI_REQUEST_TIMEOUT_MS=60000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
# MongoDB connection pool & readiness caching.
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_SLOW_QUERY_MS=100
READINESS_CACHE_TTL_MS=3000
# Dedicated HMAC secret for v1 quiz session cursors (falls back to JWT_SECRET if unset in production).
# QUIZ_CURSOR_SECRET=replace-with-a-random-cursor-secret
# Error monitoring (leave SENTRY_DSN empty to disable in local dev/test).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Authenticated Prometheus scrape token for GET /metrics (returns 404 when unset).
METRICS_TOKEN=
USE_DURABLE_QUEUE=false
# Durable queues require a separate Redis server with noeviction and healthy
# enabled persistence. A different database on the cache server is NOT isolated.
# QUEUE_REDIS_URL=rediss://user:password@queue-host:6379
# QUEUE_REDIS_NAMESPACE=meow:prod:queue
QUEUE_REDIS_ALLOW_SHARED=false
QUEUE_MAX_WAITING_JOBS=20000
QUEUE_MAX_DELAYED_JOBS=5000
QUEUE_OWNER_MAX_ENQUEUES=100
QUEUE_OWNER_WINDOW_MS=60000
QUEUE_DEDUPE_WINDOW_MS=3600000
QUEUE_MAX_READY_AGE_MS=1800000
# Speech and translation keys belong only to this backend deployable.
AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Resend email credentials belong only to the backend environment.
RESEND_API_KEY=
EMAIL_FROM="Meow <noreply@meowguru.me>"
