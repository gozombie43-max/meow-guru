PROCESS_ROLE=api
NODE_ENV=development
PORT=10000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=meow
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
# Replace both placeholders with DIFFERENT random secrets of at least 32 characters.
# Defaults enforce 100 Tutor requests, 40 MB and 10M conservative token credits per UTC day.
TUTOR_DAILY_REQUESTS=100
TUTOR_DAILY_ATTACHMENT_BYTES=41943040
TUTOR_DAILY_TOKEN_ALLOWANCE=10000000
TUTOR_QUEUED_JOBS=4
TUTOR_RUNNING_JOBS=2
QUIZ_ONLY_MODE=true
RUN_EMBEDDED_WORKERS=false
# Run npm run start:attachments with PROCESS_ROLE=attachments for tutor uploads.
# Optional shared Redis; use the provider's TLS rediss:// URL in deployment.
# REDIS_URL=rediss://user:password@host:6379
# Required with Redis on deployed APIs/workers; all instances must share it.
# REDIS_NAMESPACE=meow:prod
# Staging uses DEPLOYMENT_ENVIRONMENT=staging and REDIS_NAMESPACE=meow:staging.
# Optional integrations fail separately from Mongo-backed quiz readiness.
BATTLE_REDIS_CRITICAL=false
EMBEDDED_WORKERS_CRITICAL=false
USE_DURABLE_QUEUE=false
# Durable queues require a separate Redis server with noeviction and healthy
# enabled persistence. A different database on the cache server is NOT isolated.
# QUEUE_REDIS_URL=rediss://user:password@queue-host:6379
# QUEUE_REDIS_NAMESPACE=meow:prod:queue
QUEUE_REDIS_ALLOW_SHARED=false
QUEUE_MAX_WAITING_JOBS=20000
QUEUE_MAX_DELAYED_JOBS=5000
QUEUE_OWNER_MAX_ENQUEUES=100
QUEUE_OWNER_WINDOW_MS=60000
QUEUE_DEDUPE_WINDOW_MS=3600000
QUEUE_MAX_READY_AGE_MS=1800000
# Speech and translation keys belong only to this backend deployable.
AZURE_TTS_KEY=
AZURE_TTS_REGION=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
